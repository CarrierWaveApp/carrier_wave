# Machine-specific SDK location
/local.properties

# Release signing — the keystore is the app's permanent identity and the
# properties file holds its passwords. Never commit either; keep offline
# backups (losing the keystore means users must uninstall to update).
/carrierwave-release.jks
/keystore.properties

# Gradle / build output
.gradle/
.kotlin/
build/
app/build/
captures/

# IDE
*.iml
.idea/

# Generated by build-rust.sh — Rust core .so + UniFFI Kotlin bindings.
# These are build output, regenerated on every build; do not commit.
app/src/main/jniLibs/
app/src/main/java/uniffi/
