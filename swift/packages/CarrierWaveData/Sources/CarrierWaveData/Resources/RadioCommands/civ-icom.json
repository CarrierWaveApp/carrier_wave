      "protocol": "civ",
      "category": "rit-xit",
      "supports": ["IC-7300", "IC-7610", "IC-705", "IC-9700"],
      "params": [],
      "template": "21 00 00 00 00",
      "notes": "Zeroes the RIT/XIT offset. Does not flip the enable bit — pair with civ.rit/civ.xit if needed."
