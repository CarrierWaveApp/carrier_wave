  "capabilities": {
    "transmits": true,
    "changesFrequency": true,
    "changesMode": true,
    "changesPower": false,
    "usesRawBytes": false
  },
  "args": [
    { "name": "freq", "type": "frequency", "min": 100000, "max": 250000000000 }
  ],
  "steps": [
    { "kind": "setFrequency", "hz": 14060000 },
    { "kind": "setMode", "mode": "CW" },
    { "kind": "sendCW", "text": "TU 73" }
  ],
  "format": 2,
  "status": "approved"
