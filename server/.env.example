# Required
DATABASE_URL=postgres://challenges:challenges@localhost:5432/challenges
ADMIN_TOKEN=change-me-to-a-secure-random-string

# Optional
PORT=8080
BASE_URL=http://localhost:8080
RUST_LOG=info
# Log output format: json (default; one object per line for journald/Loki),
# pretty (multi-line, coloured) or compact (single-line text). See
# docs/logging.md. Unknown values fall back to json with a startup warning.
LOG_FORMAT=pretty
# Size of the shared sqlx pool (HTTP handlers + aggregators + background
# loops). Keep the sum across every process hitting the same Postgres below
# its `max_connections` (default 100).
DATABASE_MAX_CONNECTIONS=16

# Phase 5 OAuth (optional — the /v1/auth/* routes only mount when the JWT keys
# below are set; otherwise the legacy fd_ device-token auth keeps working).
# Generate an Ed25519 keypair:
#   openssl genpkey -algorithm ed25519 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub.pem
# Then paste the PEM contents (newlines preserved) into these vars.
JWT_ED25519_PRIVATE_PEM=
JWT_ED25519_PUBLIC_PEM=
JWT_KID=v1
# Transactional email for magic links (Resend). Unset → NullMailer logs the
# link instead of sending (DEV ONLY).
RESEND_API_KEY=
EMAIL_FROM=noreply@carrierwave.app
# QRZ XML credentials for the directory-email verification tier (D6). Unset →
# directory tier disabled; everything falls back to the weaker user_email tier
# (which cannot inherit legacy callsign data — fail-closed).
QRZ_USERNAME=
QRZ_PASSWORD=
